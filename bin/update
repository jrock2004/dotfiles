#!/usr/bin/env bash
# Cross-platform system + tooling update (macOS / Omarchy / Arch).
set -uo pipefail

banner() { printf '\n==> %s\n' "$1"; }

# --- system packages -------------------------------------------------------
banner "System packages"
if command -v omarchy >/dev/null 2>&1; then
    omarchy update
elif command -v brew >/dev/null 2>&1; then
    brew update && brew upgrade && brew doctor
elif command -v paru >/dev/null 2>&1; then
    paru -Syu
elif command -v pacman >/dev/null 2>&1; then
    sudo pacman -Syu
fi

# --- node + global npm tooling -------------------------------------------- -
# macOS manages Node with Volta; Omarchy/Arch uses mise.
if command -v volta >/dev/null 2>&1; then
    banner "Node LTS (volta)"
    volta install node@lts

    banner "Global npm tooling (volta)"
    volta install \
        @github/copilot @githubnext/github-copilot-cli @lifeart/ember-language-server \
        @tailwindcss/language-server bash-language-server cssmodules-language-server \
        diagnostic-languageserver dockerfile-language-server-nodejs ember-cli ls_emmet \
        neovim pnpm prettier typescript typescript-language-server vim-language-server \
        vscode-langservers-extracted yaml-language-server
elif command -v mise >/dev/null 2>&1; then
    banner "Runtimes (mise)"
    mise upgrade
fi

# --- neovim -------------------------------------------------------------- - -
banner "Neovim plugins"
if command -v nvim >/dev/null 2>&1; then
    nvim --headless "+Lazy! sync" +qa
    [ -d "$HOME/.config/ownnvim" ] && NVIM_APPNAME=ownnvim nvim --headless "+Lazy! sync" +qa
fi

# --- tmux plugins (only when tpm is actually in use) ----------------------
if command -v tmux >/dev/null 2>&1 && [ -x "$HOME/.tmux/plugins/tpm/bin/update_plugins" ]; then
    banner "tmux plugins"
    "$HOME/.tmux/plugins/tpm/bin/update_plugins" all
fi

banner "Done"
